meta {
  name: 01-Request Contract Offers
  type: http
  seq: 1
}

post {
  url: {{EntityB}}/catalog/request
  body: json
  auth: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{EntityB_Api_Key}}
  placement: header
}

body:json {
  {
    "@context": [
      {
        "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
      }
    ],
    "@type": "CatalogRequest",
    "counterPartyAddress": "{{EntityA_DSP}}/2025-1",
    "counterPartyId": "{{EntityA_DID}}",
    "protocol": "dataspace-protocol-http:2025-1",
    "querySpec": {
      "offset": 0,
      "limit": 50,
      "sortOrder": "DESC",
      "sortField": "fieldName",
      "filterExpression": [
        {
          "operandLeft": "https://w3id.org/edc/v0.0.1/ns/id",
          "operator": "=",
          "operandRight": "{{ASSET_ID}}"
        }
      ]
    }
  }
}

tests {
  const response = res.getBody();
  const offerId = response.dataset[0].hasPolicy[0]["@id"];
  bru.setVar("OFFER_ID", offerId);
}
